{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cuemark",
  "version": "0.1.0",
  "identifier": "com.cuemark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cuemark — Control",
        "width": 1280,
        "height": 1100,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/media/**", "/mnt/**", "/run/media/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
